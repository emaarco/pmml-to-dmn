{
  "name": "pmml-to-dmn",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "npm run build && npm run lint && npm run typecheck && npm run arch && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.5.1",
    "dependency-cruiser": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
